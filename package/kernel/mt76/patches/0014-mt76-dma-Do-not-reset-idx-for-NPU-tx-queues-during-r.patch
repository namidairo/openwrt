References: <f1fa256dca899cf2818928aa7657a2a4fbbb4ad9.1764499519.git.lorenzo@kernel.org>
From: Lorenzo Bianconi <lorenzo@kernel.org>
Date: Sun, 30 Nov 2025 10:56:00 +0100
Subject: [PATCH 14/18] mt76: dma: Do not reset idx for NPU tx queues during
 reset

Signed-off-by: Lorenzo Bianconi <lorenzo@kernel.org>
---
 dma.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dma.h b/dma.h
index 4fd779e1..298ceffc 100644
--- a/dma.h
+++ b/dma.h
@@ -174,7 +174,9 @@ void mt76_dma_queue_reset(struct mt76_dev *dev, struct mt76_queue *q,
 static inline void
 mt76_dma_reset_tx_queue(struct mt76_dev *dev, struct mt76_queue *q)
 {
-	dev->queue_ops->reset_q(dev, q, true);
+	bool reset_idx = q && !mt76_queue_is_npu_tx(q);
+
+	dev->queue_ops->reset_q(dev, q, reset_idx);
 	if (mtk_wed_device_active(&dev->mmio.wed))
 		mt76_wed_dma_setup(dev, q, true);
 }
