From ef53fc2373295e8d7bb08715f2dbc58cdffbbdfc Mon Sep 17 00:00:00 2001
Message-ID: <ef53fc2373295e8d7bb08715f2dbc58cdffbbdfc.1762612978.git.lorenzo@kernel.org>
In-Reply-To: <8f2053e60d8412024b6097368748ecaf5d329599.1762612978.git.lorenzo@kernel.org>
References: <8f2053e60d8412024b6097368748ecaf5d329599.1762612978.git.lorenzo@kernel.org>
From: Lorenzo Bianconi <lorenzo@kernel.org>
Date: Sun, 26 Oct 2025 10:42:22 +0100
Subject: [PATCH 11/12] HACK: missing npu APIs for eagle

Signed-off-by: Lorenzo Bianconi <lorenzo@kernel.org>
---
 mt7996/mmio.c   |  2 +-
 mt7996/mt7996.h |  3 ++-
 mt7996/npu.c    | 11 +++++++++--
 3 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/mt7996/mmio.c b/mt7996/mmio.c
index d9780bb4..8dc3cc7a 100644
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -826,7 +826,7 @@ struct mt7996_dev *mt7996_mmio_probe(struct device *pdev,
 		.survey_flags = SURVEY_INFO_TIME_TX |
 				SURVEY_INFO_TIME_RX |
 				SURVEY_INFO_TIME_BSS_RX,
-		.token_size = MT7996_TOKEN_SIZE,
+		.token_size = MT7996_SW_TOKEN_SIZE,
 		.tx_prepare_skb = mt7996_tx_prepare_skb,
 		.tx_complete_skb = mt76_connac_tx_complete_skb,
 		.rx_skb = mt7996_queue_rx_skb,
diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
index de31385a..010a3ba8 100644
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -83,7 +83,8 @@
 
 #define MT7996_EEPROM_SIZE		7680
 #define MT7996_EEPROM_BLOCK_SIZE	16
-#define MT7996_TOKEN_SIZE		16384
+#define MT7996_TOKEN_SIZE		28672
+#define MT7996_SW_TOKEN_SIZE		4096
 #define MT7996_HW_TOKEN_SIZE		8192
 
 #define MT7996_CFEND_RATE_DEFAULT	0x49	/* OFDM 24M */
diff --git a/mt7996/npu.c b/mt7996/npu.c
index 788ea9ce..500b0c33 100644
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -200,9 +200,10 @@ static int mt7996_npu_txrx_offload_init(struct mt7996_dev *dev,
 static int mt7996_npu_offload_init(struct mt7996_dev *dev,
 				   struct airoha_npu *npu)
 {
-	u32 val;
+	//u32 val;
 	int err;
 
+#if 0
 	err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
 			       &val, GFP_KERNEL);
 	if (err) {
@@ -212,6 +213,7 @@ static int mt7996_npu_offload_init(struct mt7996_dev *dev,
 
 	dev_info(dev->mt76.dev, "NPU version: %0d.%d\n",
 		 (val >> 16) & 0xffff, val & 0xffff);
+#endif
 
 	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
 				dev->mt76.mmio.npu_type, GFP_KERNEL);
@@ -229,12 +231,15 @@ static int mt7996_npu_offload_init(struct mt7996_dev *dev,
 	if (err)
 		return err;
 
+#if 0
 	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_TOKEN_ID_SIZE,
 				MT7996_HW_TOKEN_SIZE, GFP_KERNEL);
 	if (err)
 		return err;
+#endif
+	printk("[%s-%d] FIXME missing NPU APIs\n", __func__, __LINE__);
 
-	dev->mt76.token_start = MT7996_HW_TOKEN_SIZE;
+	dev->mt76.token_start = MT7996_TOKEN_SIZE;
 
 	return 0;
 }
@@ -566,6 +571,8 @@ int mt7996_npu_hw_init(struct mt7996_dev *dev)
 
 	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++)
 		airoha_npu_wlan_enable_irq(npu, i - MT_RXQ_NPU0);
+
+	printk("[%s-%d] NPU in business!\n", __func__, __LINE__);
 unlock:
 	mutex_unlock(&dev->mt76.mutex);
 
-- 
2.51.1

